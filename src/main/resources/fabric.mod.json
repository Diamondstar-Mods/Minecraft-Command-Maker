{
	"schemaVersion": 1,
	"id": "modid",
	"version": "${version}",
	"name": "Nek's Command Maker!",
	"description": "NEKKY COMMAND MAKER",
	"authors": [
		"NekSheep9180 aka lucgei231"
	],
	"contact": {
		"homepage": "https://github.com/Diamondstar-Mods/Minecraft-Command-Maker",
		"sources": "https://github.com/Diamondstar-Mods/Minecraft-Command-Maker"
	},
	"license": "CC0-1.0",
	"icon": "assets/modid/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.ExampleMod"
		],
		"client": [
			"com.example.ExampleModClient"
		]
	},
	"mixins": [
		"modid.mixins.json",
		{
			"config": "modid.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.15.0",
		"minecraft": ">=1.20 <=26.1",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}
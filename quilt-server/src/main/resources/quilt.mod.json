{
  "schema_version": 1,
  "quilt_loader": {
    "group": "com.example",
    "name": "Nek's Command Maker",
    "version": "${version}",
    "metadata": {
      "name": "Nek's Command Maker! - Quilt Server",
      "description": "NEKKY COMMAND MAKER - Quilt Server Edition",
      "authors": ["NekSheep9180 aka lucgei231"],
      "contact": {
        "homepage": "https://github.com/Diamondstar-Mods/Minecraft-Command-Maker",
        "sources": "https://github.com/Diamondstar-Mods/Minecraft-Command-Maker",
        "issues": "https://github.com/Diamondstar-Mods/Minecraft-Command-Maker/issues"
      },
      "license": "CC0-1.0",
      "icon": "assets/modid/icon.png"
    },
    "mixin": ["modid.mixins.json"],
    "plugins": ["com.example.ExampleMod"],
    "entrypoints": {
      "init": ["com.example.ExampleMod"]
    },
    "depends": [
      {
        "id": "quilt_loader",
        "versions": ">=0.27.0"
      },
      {
        "id": "quilted_fabric_api",
        "versions": "*"
      },
      {
        "id": "quilt_standard_libraries",
        "versions": "*"
      },
      {
        "id": "minecraft",
        "versions": ">=1.21.9"
      },
      {
        "id": "java",
        "versions": ">=21"
      }
    ]
  }
}
